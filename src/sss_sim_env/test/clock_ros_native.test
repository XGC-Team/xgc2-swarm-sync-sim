<launch>
  <arg name="control_socket"/>
  <param name="/use_sim_time" value="true"/>
  <param name="/use_sss_sim_time" value="true"/>
  <param name="/sss_clock/control_socket" value="$(arg control_socket)"/>
  <node pkg="nodelet" type="nodelet" name="sss_native_manager" args="manager" output="screen">
    <param name="num_worker_threads" value="2"/>
  </node>
  <node pkg="nodelet" type="nodelet" name="sss_native_clock"
        args="load sss_sim_env/sim_clock_nodelet /sss_native_manager" output="screen">
    <param name="control_socket" value="$(arg control_socket)"/>
    <param name="auto_start" value="false"/>
    <param name="max_speed_ratio" value="1.0"/>
  </node>
  <test pkg="sss_sim_env" type="sss_clock_ros_native_test" test-name="sss_clock_native_checks" time-limit="15">
    <param name="control_socket" value="$(arg control_socket)"/>
  </test>
</launch>
